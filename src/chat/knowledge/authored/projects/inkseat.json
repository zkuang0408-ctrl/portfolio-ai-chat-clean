          "sourceId": "inkseat",
          "page": 6
        }
      ],
      "intents": [
        "problem",
        "research"
      ],
      "topics": [
        "客舱趋势",
        "机上广告",
        "座位级触点",
        "渠道取舍"
      ],
      "public": true
    },
    {
      "id": "inkseat.solution",
      "text": "方案在完整座椅背 IFE 与纯 BYOD 客舱之间增加一层轻量、低功耗、低干扰的信息显示层，用于承载航程、服务与商业内容。",
      "provenance": "document_synthesis",
      "evidence": [
        {
          "sourceId": "inkseat",
          "page": 1
        },
        {
          "sourceId": "inkseat",
          "page": 6
