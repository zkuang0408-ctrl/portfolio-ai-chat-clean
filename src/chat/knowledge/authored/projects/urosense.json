  "claims": [
    {
      "id": "urosense.overview",
      "text": "UroSense 是面向医院心内科病房场景的智能尿量检测附件概念，尝试让有自主如厕能力的患者在尽量保护隐私、减少人工转移的前提下完成尿量收集、计量与概念性数据归档。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "urosense", "page": 1 },
        { "sourceId": "urosense", "page": 9 },
        { "sourceId": "urosense", "page": 10 }
      ],
      "intents": ["overview", "solution", "value"],
      "topics": ["心内科病房", "尿量检测附件", "隐私", "自主使用", "概念设计"],
      "public": true
    },
    {
      "id": "urosense.research",
      "text": "作品记录了医院调研中与病房仪器、线缆、用药、尿量记录等相关的观察，并把 24 小时尿量作为心衰照护场景中的关注指标；展示的调研条目和排尿日记示例属于项目研究材料，不构成临床统计或验证。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "urosense", "page": 3 },
        { "sourceId": "urosense", "page": 4 },
        { "sourceId": "urosense", "page": 5 }
      ],
      "intents": ["research"],
      "topics": ["医院调研", "心内科病房", "24 小时尿量", "排尿日记", "项目观察"],
      "public": true
    },
    {
      "id": "urosense.problem",
      "text": "项目把现有尿量记录流程中的兼顾困难、漏测漏记和无效数据，以及把尿液从尿壶或尿袋倒入量杯所增加的转移、清洁与心理负担，归纳为主要问题；页面还区分了可自主活动患者与卧床导尿患者的不同情境。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "urosense", "page": 6 },
        { "sourceId": "urosense", "page": 7 },
        { "sourceId": "urosense", "page": 8 }
      ],
      "intents": ["problem", "research"],
      "topics": ["漏测漏记", "人工转移", "量杯测量", "心理负担", "患者情境"],
      "public": true
    },
    {
      "id": "urosense.principles",
      "text": "项目提出三个设计原则：尽量保护隐私、支持患者自主使用，并减少对既有如厕习惯的打扰。",
      "provenance": "document_fact",
      "evidence": [{ "sourceId": "urosense", "page": 9 }],
      "intents": ["research", "solution", "value"],
      "topics": ["隐私保护", "自主使用", "低打扰", "生活习惯"],
      "public": true
    },
    {
      "id": "urosense.structure",
      "text": "结构与形态页面把可拆卸易清洗漏斗、载重板、坐便器适配底板、带识别区和显示端的扶手、流量计、电源与数据连接组织为一套附件。爆炸图标出总开关、电池、接线部件、信号线、流量计和膨胀螺栓等构成；标示中的螺丝固定附件，扶手识别区读取患者腕带，两者属于不同部位和用途。后续页面记录收集容器参考与非对称开口的形态探索、环形底板与中央漏斗的整体俯视渲染、标有 473、424、338、200 等数值的俯视尺寸图、侧视高度关系，以及漏斗下收曲面的线框近景。",
      "provenance": "document_fact",
      "evidence": [
        { "sourceId": "urosense", "page": 12 },
        { "sourceId": "urosense", "page": 13 },
        { "sourceId": "urosense", "page": 17 },
        { "sourceId": "urosense", "page": 18 },
        { "sourceId": "urosense", "page": 19 },
        { "sourceId": "urosense", "page": 20 },
        { "sourceId": "urosense", "page": 24 }
      ],
      "intents": ["architecture", "technology", "form"],
      "topics": ["可拆卸漏斗", "载重板", "坐便器适配", "爆炸结构", "螺丝固定", "扶手识别区", "患者腕带", "流量计", "形态探索", "整体渲染", "尺寸图", "线框近景"],
      "public": true
    },
    {
      "id": "urosense.measurement-flow",
      "text": "概念使用流程为：患者扶住扶手，识别区读取身份腕带；尿液进入漏斗并通过内置流量计，流动带动磁铁齿轮产生电信号；信号传到扶手端计算并显示尿量；患者离开后，页面设想把带时间和患者关联的信息上传至医院系统，随后可拆下漏斗清洗。该流程表达的是系统架构概念，不代表测量精度或医院系统接入已经验证。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "urosense", "page": 14 },
        { "sourceId": "urosense", "page": 16 }
      ],
      "intents": ["architecture", "interaction", "technology", "solution", "comparison"],
      "topics": ["腕带识别", "漏斗", "流量计", "磁铁齿轮", "尿量显示", "概念数据上传", "清洗"],
      "public": true
    },
    {
      "id": "urosense.installation",
      "text": "安装呈现把 UroSense 主体作为坐便器附件放置在便圈区域并保留前部开口，体现免改造式搭载意图；页面是概念渲染，没有展示多型号适配或安装可靠性验证。",
      "provenance": "document_fact",
      "evidence": [{ "sourceId": "urosense", "page": 21 }],
