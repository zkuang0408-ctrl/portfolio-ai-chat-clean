{
  "projectId": "atempo",
  "title": "Atempo",
  "aliases": [
    "a tempo",
    "桌面节律交互系统",
    "desktop rhythm interaction system",
    "缓律"
  ],
  "oneLine": "利用桌面充电过渡窗口、呼吸与灯光反馈帮助用户从任务状态切换至恢复状态的桌面节律交互系统",
  "pageCount": 20,
  "claims": [
    {
      "id": "atempo.overview",
      "text": "Atempo 是一个桌面节律交互系统概念：它利用任务结束后把设备放回桌面充电的过渡窗口，以非接触呼吸感知、双弧运动与环境灯光反馈，帮助用户从任务状态转向恢复状态。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "atempo", "page": 1 },
        { "sourceId": "atempo", "page": 8 }
      ],
      "intents": ["overview", "solution", "value"],
      "topics": ["桌面节律交互", "充电过渡窗口", "非接触呼吸感知", "环境灯光反馈"],
      "public": true
    },
    {
      "id": "atempo.problem",
      "text": "作品将高认知负荷任务结束后仍停留在工作或学习惯性、未自动进入恢复状态，归纳为值得设计介入的状态切换问题；页面引用的研究用于说明设计背景，不应外推为本作品自身的效果验证。",
      "provenance": "document_synthesis",
      "evidence": [{ "sourceId": "atempo", "page": 4 }],
      "intents": ["problem", "research"],
      "topics": ["任务惯性", "心理抽离", "恢复过渡", "设计背景"],
      "public": true
    },
    {
      "id": "atempo.opportunity",
      "text": "项目把 Atempo 定位在环境感知与实时引导之间：不要求长期佩戴或主动训练，而是把桌面充电停留、设备归位、双弧靠近和稳定光场组织成一次低门槛的恢复流程。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "atempo", "page": 6 },
        { "sourceId": "atempo", "page": 7 }
      ],
      "intents": ["problem", "research", "value"],
      "topics": ["竞品矩阵", "介入窗口", "低门槛流程", "桌面充电"],
      "public": true
    },
    {
      "id": "atempo.scenario",
      "text": "典型场景面向大学生和青年上班族：在高强度学习、工作或创作后回到桌面，把设备放上充电底座，依次经历呼吸显影、双弧靠近、节律同步和回稳陪伴。",
      "provenance": "document_fact",
      "evidence": [{ "sourceId": "atempo", "page": 10 }],
      "intents": ["research", "interaction"],
      "topics": ["大学生", "青年上班族", "桌面场景", "回稳陪伴"],
      "public": true
    },
    {
      "id": "atempo.interaction",
      "text": "交互流程分为进入与唤醒、感知与采样、节律映射与引导、回稳确认与陪伴四阶段：底座唤醒后采集短时呼吸并建立基线，系统生成目标慢呼吸并通过弧线关系持续反馈，接近目标后转入稳定光场。",
      "provenance": "document_fact",
      "evidence": [{ "sourceId": "atempo", "page": 11 }],
      "intents": ["interaction", "solution"],
      "topics": ["四阶段流程", "呼吸采样", "节律映射", "回稳光场"],
      "public": true
    },
    {
      "id": "atempo.biofeedback",
      "text": "作品中的设计依据把呼吸视为低门槛的节律入口，并采用 0.1 Hz（约每分钟 6 次呼吸）作为目标节奏参考，同时以中等至中高视觉复杂度组织弧形灯光；这些内容是作品选取交互参数的理论依据，不代表 Atempo 已完成医疗或临床层面的功效验证。",
      "provenance": "document_synthesis",
      "evidence": [{ "sourceId": "atempo", "page": 12 }],
      "intents": ["research", "technology", "interaction"],
      "topics": ["0.1 Hz", "目标呼吸节奏", "生物反馈设计依据", "视觉复杂度"],
      "public": true
    },
    {
      "id": "atempo.data-translation",
      "text": "数据转译逻辑包含四层：毫米波雷达感知胸腔微动并估计呼吸频率与稳定性；系统比较当前节律与 0.1 Hz 目标的距离和趋势；当前呼吸映射为动态弧线、目标节律映射为稳定弧线，并以错位、速度和距离表达靠近程度；当波动减小且持续接近目标时，弧线趋于同步并进入稳定光效。",
      "provenance": "document_fact",
      "evidence": [{ "sourceId": "atempo", "page": 13 }],
      "intents": ["architecture", "interaction", "technology", "comparison"],
      "topics": ["呼吸波动", "目标差值", "双弧相位", "稳定反馈", "数据转译"],
      "public": true
    },
    {
      "id": "atempo.technology",
      "text": "技术路径图以 LD6002 毫米波呼吸雷达读取存在、速率和信号强度，经滤波与状态机处理后估计呼吸相位，再由相位模型驱动钟摆式机械运动，并通过 ESP32-S3 控制 COB 灯带与灯光引擎；这是作品展示的模块与控制方案，不等同于已经完成整机性能验证。",
      "provenance": "document_fact",
      "evidence": [{ "sourceId": "atempo", "page": 15 }],
      "intents": ["technology", "architecture"],
      "topics": ["毫米波雷达", "滤波与状态机", "相位模型", "ESP32-S3", "灯光引擎", "COB 灯带"],
      "public": true
    },
    {
      "id": "atempo.form",
      "text": "产品呈现把圆形竖向节律显示面置于桌面充电底座上，以同心分段弧槽承载灯光和相位变化，底座前方的渐变相位灯槽显示呼吸趋动与同步状态；用户旅程图把靠近、捕捉呼吸、生成相位、钟摆同步、情绪反馈和节律沉淀串联起来。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "atempo", "page": 17 },
        { "sourceId": "atempo", "page": 18 }
      ],
      "intents": ["form", "interaction", "value"],
      "topics": ["桌面充电底座", "竖向节律显示面", "同心弧槽", "相位灯槽", "用户旅程"],
      "public": true
    },
