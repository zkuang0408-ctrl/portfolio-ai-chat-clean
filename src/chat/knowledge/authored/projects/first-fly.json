        { "sourceId": "first-fly", "page": 19 },
        { "sourceId": "first-fly", "page": 20 }
      ],
      "intents": ["form", "architecture", "value"],
      "topics": ["椭圆外环", "俯卧姿态", "空间利用", "舒适性", "轻量化", "CMF"],
      "public": true
    },
    {
      "id": "first-fly.motion",
      "text": "运动反馈构想让座椅上下摆动，以身体运动线索配合俯卧姿态提供飞行动感；这是未来概念中的体验机制，没有展示运动参数或工程验证。",
