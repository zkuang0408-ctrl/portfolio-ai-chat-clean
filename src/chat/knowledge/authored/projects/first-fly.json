  "oneLine": "面向 2035 短途出行的未来沉浸式飞行体验概念，以俯卧第一人称身体姿态、座椅运动反馈和 AR 景观营造飞行感",
  "pageCount": 28,
  "claims": [
    {
      "id": "first-fly.overview",
      "text": "First Fly 是面向 2035 年短途出行的未来沉浸式飞行体验概念：它把环形客舱座椅、可在坐姿与俯卧姿态间切换的身体支撑、座椅运动反馈和 AR 景观组织在一起，尝试让乘客以第一人称感受飞行。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "first-fly", "page": 1 },
        { "sourceId": "first-fly", "page": 10 },
        { "sourceId": "first-fly", "page": 11 }
      ],
      "intents": ["overview", "solution", "value"],
      "topics": ["2035 短途出行", "未来概念", "沉浸式飞行", "第一人称视角", "环形座椅"],
      "public": true
    },
    {
      "id": "first-fly.premise",
      "text": "项目从“想知道飞究竟是什么感觉”的个人愿望切入，并用空中视角、俯卧飞行姿态和虚构飞行画面构成体验前提。",
      "provenance": "document_synthesis",
      "evidence": [{ "sourceId": "first-fly", "page": 3 }],
      "intents": ["problem", "research"],
      "topics": ["飞行愿望", "第一人称感受", "空中视角", "俯卧姿态"],
      "public": true
    },
    {
      "id": "first-fly.research",
      "text": "研究部分围绕 2035 城市与短途出行预测、AR 眼镜与环境感知、客舱空间和人体动作尺度，以及未来飞行服务叙事展开；页面中的市场预测与未来场景属于作品引用和构想，不代表项目已经部署。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "first-fly", "page": 4 },
        { "sourceId": "first-fly", "page": 5 },
        { "sourceId": "first-fly", "page": 6 },
        { "sourceId": "first-fly", "page": 7 },
        { "sourceId": "first-fly", "page": 8 },
        { "sourceId": "first-fly", "page": 9 }
      ],
      "intents": ["research"],
      "topics": ["2035 出行", "AR 眼镜", "环境感知", "人体尺度", "客舱空间", "未来场景"],
      "public": true
    },
    {
      "id": "first-fly.concept",
      "text": "设计概念面向短途小型电动公务机或类似未来短途飞行场景，以俯卧第一人称体感座椅作为核心物品层，并向人物、故事、场景与世界观扩展；作品设想乘客借助轻量智能终端与 AR 从鸟瞰视角观看沿途景观，在约一小时航程中形成沉浸式体验。",
      "provenance": "document_synthesis",
      "evidence": [
        { "sourceId": "first-fly", "page": 10 },
        { "sourceId": "first-fly", "page": 11 }
      ],
      "intents": ["solution", "architecture", "interaction", "comparison"],
      "topics": ["俯卧第一人称座椅", "短途飞行", "AR 景观", "故事场景", "未来世界观"],
      "public": true
    },
    {
      "id": "first-fly.users",
      "text": "作品把设想用户分为 18 岁以下青少年、约 25 岁年轻人和退休老年人，并分别强调科普与好奇、追求新奇沉浸体验、以及舒适安全与姿态切换等不同需要。",
      "provenance": "document_fact",
      "evidence": [
        { "sourceId": "first-fly", "page": 12 },
        { "sourceId": "first-fly", "page": 13 }
      ],
      "intents": ["research", "value"],
      "topics": ["青少年", "年轻人", "退休老年人", "用户需求", "姿态切换"],
      "public": true
    },
    {
      "id": "first-fly.journey",
      "text": "用户旅程从登机前的偏好与健康信息设置、装置介绍和安全体验预览，进入飞行中的俯卧模式、座椅联动与 AR 视觉引导，再到离机后的平稳过渡和目的地活动建议。",
      "provenance": "document_fact",
      "evidence": [{ "sourceId": "first-fly", "page": 14 }],
      "intents": ["interaction", "value"],
      "topics": ["登机前", "俯卧模式", "座椅联动", "AR 视觉引导", "离机后"],
      "public": true
    },
    {
      "id": "first-fly.form",
      "text": "形态设计从多轮环形座椅草图收敛为椭圆外环、中央姿态切换座椅和环形支撑界面，强调空间利用、舒适与轻量化；页面展示坐姿到俯卧的活动范围、贴合人体曲线的软质座椅、半隐私围合、结构拆解，以及尼龙、聚氨酯记忆棉、轻质镁合金与碳纤维等概念 CMF 标注。",
      "provenance": "document_synthesis",
      "evidence": [
